{
  "name": "naria-design-atlas",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:motion && npm run build:system && tsc --noEmit && tsc -p tsconfig.motion.json --noEmit && tsc -p tsconfig.ui.json && node scripts/build-ui.mjs && vite build && node scripts/standalone.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "build:motion": "node scripts/build-motion.mjs",
    "build:system": "node scripts/build-system-tokens.mjs && node scripts/build-system-api.mjs",
    "build:ui": "node scripts/build-system-tokens.mjs && tsc -p tsconfig.ui.json && node scripts/build-ui.mjs",
    "test:examples": "node scripts/check-system-examples.mjs"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.42.2",
    "lucide-react": "0.577.0",
    "motion": "12.42.2",
    "motion-dom": "12.42.2",
    "motion-utils": "12.39.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "overrides": {
    "esbuild": "0.27.3"
  }
}
